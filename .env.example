# ===== 必要 =====
# Telegram API（my.telegram.org）
TG_API_ID=30279608
TG_API_HASH=你的tg_api_hash
# 帳號 session 加密金鑰（Fernet，44 字元 base64）
# 產生：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ACCOUNT_ENCRYPTION_KEY=
# 控制台密碼（必填）
DASHBOARD_PASS=

# ===== AI（預設 RunPod 本機部署）=====
# 留空 AI_BASE_URL 會用預設 RunPod 位址
AI_API_KEY=
AI_BASE_URL=https://9ghyzu98lbv2mf-8000.proxy.runpod.net/v1
AI_MODEL=
AI_TEMPERATURE=0.85
AI_MAX_TOKENS=200
AI_TIMEOUT=60

# ===== 控制台 =====
DASHBOARD_USER=admin
PORT=8000

# ===== 資料庫 =====
DB_PATH=/data/chat.db

# ===== 記憶 =====
MEMORY_MAX_MESSAGES=30
MEMORY_TTL_HOURS=24

# ===== 回覆行為 =====
# 真人訊息基礎回覆概率（0-1）
BASE_REPLY_PROBABILITY=0.35
# 水軍對水軍互聊概率（群自己會活）
WATER_CROSS_TALK_PROBABILITY=0.15

# ===== 主動發言 =====
PROACTIVE_ENABLED=1
PROACTIVE_MAX_PER_DAY=4
PROACTIVE_MIN_INTERVAL_MINUTES=45

# ===== 打字延遲（秒）=====
MIN_TYPING_DELAY=1.5
MAX_TYPING_DELAY=4.0
