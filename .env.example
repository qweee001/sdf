# Telegram application credentials — shared by all managed accounts.
# Placeholders only. Never commit real values.
TG_API_ID=
TG_API_HASH=

# Optional one-time import of the existing account.
# After import, add more accounts from the dashboard.
TG_SESSION_STRING=

# Global OpenAI-compatible fallback. Each account may override these in the dashboard.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never change this after accounts have been saved, or their credentials cannot be decrypted.
ACCOUNT_ENCRYPTION_KEY=
MAX_ACCOUNTS=10

# Defaults used only when importing the legacy TG_SESSION_STRING.
ACCOUNT_GENDER=male
ACCOUNT_STAGE=old_member
ACCOUNT_STYLE=穩重、自然、偶爾幽默，喜歡聊日常與交友觀念

# Leave empty to allow every group this account has joined.
# Recommended: comma-separated Telegram IDs such as -1001234567890
GROUP_CHAT_IDS=
# Legacy compatibility only. Managed accounts automatically ignore one another.
IGNORE_SENDER_IDS=

# Group reply behaviour
GROUP_REPLY_PROBABILITY=0.35
REPLY_ON_MENTION=true
REPLY_ON_REPLY=true
TYPING_DELAY_MIN_SECONDS=1.5
TYPING_DELAY_MAX_SECONDS=5

# Optional proactive group conversation after a group has been observed.
PROACTIVE_ENABLED=true
PROACTIVE_IDLE_MINUTES=15
PROACTIVE_MIN_INTERVAL_MINUTES=25
PROACTIVE_MAX_INTERVAL_MINUTES=60
MAX_PROACTIVE_PER_DAY=24

# Memory
MEMORY_TTL_HOURS=24
MEMORY_HISTORY_LIMIT=30
MEMORY_DB_PATH=/data/memory.db

# Password-protected multi-account web dashboard
DASHBOARD_ENABLED=false
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
PORT=8000

# Logging
LOG_LEVEL=INFO
